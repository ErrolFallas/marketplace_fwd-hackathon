# ─────────────────────────────────────────────────────────────────────────────
# Marketplace FWD — contrato de variables de entorno
#
# Cómo usar:
#   cp .env.local.example .env.local
#   y completar con las llaves reales (las comparte el equipo).
#
# Reglas:
#   - .env.local NUNCA se commitea (está en .gitignore). Este .example SÍ.
#   - Este archivo lleva SOLO placeholders, jamás valores reales: si se filtrara
#     un secreto aquí, el .gitignore no serviría de nada.
#   - Toda variable NEXT_PUBLIC_* se expone al navegador. No poner secretos ahí.
#   - Las variables sin prefijo NEXT_PUBLIC_ son SOLO servidor.
#   - reglas.md §"Zod en todas las fronteras": estas vars deben validarse con Zod
#     antes de usarse.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase — REQUERIDAS (MVP) ──────────────────────────────────────────────
# URL del proyecto Supabase del equipo. Pública (va al cliente).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon). Va al cliente; queda sometida a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Clave de servicio. SOLO servidor, jamás exponer al cliente (reglas.md §115, §13 FAQ).
# Saltea RLS: si se filtra, se compromete toda la base.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Contraseña de la base (rol postgres). La usa el tooling (CLI `npx supabase`,
# conexión directa / MCP fwd-db-env), NO el código de la app. Solo servidor/local.
SUPABASE_DB_PASSWORD=tu_db_password


# ── IA — Generador de propuestas (feature new-project, 2.4 + 2.10) ────────────
# Variables EXCLUSIVAS del generador de propuestas (/empresario/new-project).
# El código las lee SOLO en src/lib/proposal-ai/config.ts y pasa la key explícita
# al cliente, así ninguna otra parte de la app las consume.
#
# CONVENCIÓN DE EQUIPO — nombrá las variables de IA por FUNCIÓN, no por proveedor:
#   - Cada feature de IA usa su propio prefijo <FEATURE>_AI_* con SU PROPIA key.
#   - NO reutilices PROPOSAL_AI_* para otra integración: gastarías la key del
#     generador de propuestas. Para otra feature creá, p.ej., MATCHING_AI_API_KEY.
#
# Solo servidor (sin prefijo NEXT_PUBLIC_): NUNCA exponer al cliente.

# Llave de OpenRouter (API OpenAI-compatible). REQUERIDA para el generador.
# La key es de openrouter.ai (NO de platform.openai.com).
# Obtenela en https://openrouter.ai/keys y pegá el valor real en .env.local.
PROPOSAL_AI_API_KEY=

# Modelo a usar (slug de OpenRouter). Se registra en conversaciones_ia.modelo_ia.
PROPOSAL_AI_MODEL=openai/gpt-oss-120b

# Base URL del gateway OpenAI-compatible. OpenRouter es el proveedor activo.
PROPOSAL_AI_BASE_URL=https://openrouter.ai/api/v1


# ── IA — Proveedores RESERVADOS para uso futuro ──────────────────────────────
# Espacio preparado por si un módulo de IA se cambia de proveedor. Hoy SIN uso en
# código (el generador y el filtro usan OpenRouter). Solo servidor. Dejar vacío.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=


# ── Email — Resend, RESERVADO (migración futura desde Gmail SMTP) ─────────────
# Prevista la migración del emisor de correos de Gmail SMTP a Resend para mejorar
# la entregabilidad (evitar spam). Hoy SIN uso en código; el emisor activo sigue
# siendo Gmail (abajo). Solo servidor. Obtenela en https://resend.com/api-keys.
RESEND_API_KEY=


# ── Email — Gmail SMTP (emisor activo de correos) ────────────────────────────
# Emisor real de correos: nodemailer con service:'gmail' (src/lib/email/gmail.ts).
# Lo usan el aviso a oferentes al editar un proyecto y el flujo de auth. Solo servidor.
#   - GMAIL_USER: dirección Gmail emisora; debe ser un email válido.
#   - GMAIL_APP_PASSWORD: App Password de Google de 16 caracteres (NO la contraseña
#     de la cuenta). Requiere 2-Step Verification activado. Generala en
#     https://myaccount.google.com/apppasswords y pegá los 16 caracteres SIN espacios.
# Si faltan, el envío de email se omite (se loguea) y la notificación in-app sigue.
GMAIL_USER=
GMAIL_APP_PASSWORD=


# ── IA — Filtro de ofertas (postulaciones, SRS 2.10) ─────────────────────────
# Filtro de postulaciones vía OpenRouter (src/lib/ai-filtro-ofertas/). Solo
# servidor, OPCIONALES: si faltan, el filtro se omite (best-effort). Cada feature
# de IA usa su propio prefijo <FEATURE>_AI_* / key (no reutilizar PROPOSAL_AI_*).
OPENROUTER_FILTRO_OFERTAS_API_KEY=
OPENROUTER_FILTRO_OFERTAS_MODEL=


# ── IA — Moderador de convivencia (agente que revisa texto libre) ─────────────
# Agente que analiza texto libre entre usuarios (mensajes, comentarios/réplicas de
# evaluaciones, comentarios de entregables, carta de postulación, portafolio, bio)
# y reporta al admin posible lenguaje ofensivo/conducta inapropiada. SOLO informa;
# el admin decide. Código en src/lib/moderador-ai/ (lo lee solo su config.ts).
#
# CONVENCIÓN DE EQUIPO — cada feature de IA usa su prefijo <FEATURE>_AI_* con SU
# PROPIA key (no reutilizar la del generador de propuestas ni la del filtro).
# Solo servidor (sin prefijo NEXT_PUBLIC_): NUNCA exponer al cliente.

# Llave de OpenRouter (API OpenAI-compatible). REQUERIDA para el moderador.
MODERATOR_AI_API_KEY=

# Modelo a usar (slug de OpenRouter). Se registra en el ledger de análisis.
MODERATOR_AI_MODEL=openai/gpt-4o-mini

# Base URL del gateway OpenAI-compatible. OpenRouter es el proveedor activo.
MODERATOR_AI_BASE_URL=https://openrouter.ai/api/v1


# ── Imágenes — Cloudinary (foto de perfil, RF-06) ────────────────────────────
# Subida de la foto de perfil (src/lib/portfolio). Solo servidor, OPCIONALES: si
# faltan, no funciona la subida de foto (el resto de la app sigue).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ── URL pública de la app (opcional) ─────────────────────────────────────────
# URL pública del despliegue (p.ej. https://<app>.vercel.app). Se valida como URL
# si está presente. En Vercel, setearla a la URL de producción.
NEXT_PUBLIC_APP_URL=


# ── Google OAuth — presentes en el env del equipo, NO consumidas por el código ─
# El login con Google/GitHub lo maneja Supabase Auth desde su dashboard
# (Authentication → Providers), NO la app: el código solo invoca el OAuth de
# Supabase y nunca lee estas variables. Se dejan documentadas porque existen en el
# .env.local del equipo; podés omitirlas sin afectar la app. Solo servidor.
#   La "Authorization callback URL" de la OAuth App de GitHub (y el "Authorized
#   redirect URI" de Google) deben apuntar al callback de Supabase:
#   https://<TU-PROYECTO>.supabase.co/auth/v1/callback
#   Las "Redirect URLs" de Supabase deben incluir la de la app:
#   http://localhost:3000/auth/callback (dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
